# Hostinger (LiteSpeed/Apache) equivalent of public/_headers.
# _headers is a Cloudflare Pages feature and is inert here, so the same
# security headers and caching are restated in the form this host reads.
# Keep the two files in step, or delete _headers if Cloudflare is never used.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Vite fingerprints these, so they can never go stale.
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media is stable but not fingerprinted: a week.
  <FilesMatch "\.(mp4|webm|jpg|jpeg|png|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Always revalidate the documents themselves, or a deploy goes unseen.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Serve .mjs correctly if the host does not know it.
<IfModule mod_mime.c>
  AddType application/javascript .mjs
</IfModule>
